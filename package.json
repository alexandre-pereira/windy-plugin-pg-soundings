    },
    "keywords": [
        "windy",
        "windy.com",
        "plugins",
        "parapente"
    ],
    "repository": "github:alexandre-pereira/windy-plugin-pg-soundings",
    "license": "ISC",
    "dependencies": {
        "@windycom/plugin-devtools": "^3.0.4"
    },
    "devDependencies": {
        "vitest": "^3.2.7"
    }
}
