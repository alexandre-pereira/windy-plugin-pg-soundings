{
    "name": "windy-plugin-pg-soundings",
    "version": "1.12.0",
    "description": "Paragliding forecast for Windy.com: wind & thermals by altitude, sounding",
    "main": "dist/plugin.min.js",
    "type": "module",
    "scripts": {
        "start": "rollup -w -c",
        "build": "rollup -c --environment SERVE:false",
        "test": "vitest run",
